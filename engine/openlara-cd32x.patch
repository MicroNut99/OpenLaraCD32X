+
+/* returns the file length, -1 not on the disc, -2 bad chunk(s), -3/-4 no answer */
+static int32 cdLoadToCart(uint16 file)
+{
+    MARS_SYS_COMM2 = file;
+    cdCmd(CD_CMD_OPEN_FILE);
+    if (MARS_SYS_COMM0 != 0)
+        return -3;
+    int32 len = (int32)CD_COMM8_32;                 /* CMD 46 reads it back from COMM8 */
+    if (len <= 0)
