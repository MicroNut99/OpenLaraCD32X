+                SPL_AXIS(X, Y, X0, output);\
+            } else if (a->v.X > X1) {\
+                if (b->v.X > X1) continue;\
+                SPL_AXIS(X, Y, X1, output);\
+            }\
+            if (b->v.X < X0) {\
