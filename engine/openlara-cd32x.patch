+#ifdef CD32X
+/* ---------------------------------------------------------------------------------------
+ * CD32X build (Sega CD + 32X + 4 MB RAM cart).
+ * The Genesis side does NOT run OpenLara's own 68000 code (src-md).  The 68000 stays in the
+ * CD32X listener (hw_md.s) and the Sub-CPU service loop (Demo/main.c) answers requests the
+ * master SH2 writes to COMM0, exactly like Kobo and the D32XR loader:
+ *   SH2 writes COMM0 = command, the Sub-CPU replies and clears COMM0 when done.
+ * --------------------------------------------------------------------------------------- */
+#define CD_CMD_GET_PAD      48      /* reply: pad 1 bits (SEGA_CTRL_*) in COMM8 */
+#define CD_CMD_TEXT_ONOFF   52      /* COMM2 = 1 on / 0 off - Genesis display */
+#define CD_CMD_SFX_LOAD     53      /* OL-6: COMM2 = level -> SFX<level>.BIN into the PCM chip */
+int32 sndTakePending();             /* OL-6: sound.cpp - this frame's sound effect (0 = none) */
+
+static void cdPause()               /* hardware rule: never hammer a COMM register */
+{
+    for (volatile int32 k = 0; k < 64; k++) {}
+}
+
+static void cdCmd(uint16 cmd)
+{
+    MARS_SYS_COMM0 = cmd;
+    for (int32 n = 0; n < 2000000 && MARS_SYS_COMM0 != 0; n++)
+        cdPause();
+}
+
+/* ---------------------------------------------------------------------------------------
+ * OL-2b: levels are loaded from the CD into the RAM cart (cart offset 2 MB = slot 16).
+ *   CMD 38 with COMM2 = 100 + LevelID opens "<level>.PKD" (subcpu/main.c maps the names),
+ *   then CMD 46 per 32 KB chunk: the Sub-CPU reads the sectors and the 68000 copies them
+ *   into the cart, with RV = 1 for the copy.
+ * NO PARKING, NO SDRAM CODE: while RV = 1 an SH2 access to the cart is simply HELD until the
+ *   68000 clears RV again (D32XR/SRB32X rely on this: their 68000 sets RV for VDP DMA and
+ *   SRAM saves while both SH2s run from the cartridge).  So both SH2s stay in their normal
+ *   code; they just pause for the few milliseconds of each copy.
+ * After the load both SH2s clear their caches (the old level may still be cached).
+ * Status codes in COMM12 (the Sub-CPU shows them as STATE: when the green text is on):
+ *   4Fxx loading level xx   4E8n chunk n done   4E14 level ready   4B10 game loop running
+ *   4EE1 file not on the disc   4EE2 bad chunk(s)   4EE3/4EE4 the Sub-CPU did not answer
+ * --------------------------------------------------------------------------------------- */
+#define CD_CMD_OPEN_FILE      38
+#define CD_CMD_CHUNK_TO_CART  46
+#define CD_FILE_LEVEL_BASE    100           /* subcpu/main.c: 100 + LevelID -> .PKD, slot 16 */
+#define CD_LEVEL_CART         0x02200000    /* cart offset 0x200000 as the SH2 sees it      */
+#define MARS_CMD_CACHE        0x7A5B        /* slave command: clear your cache              */
+#define CD_STATE(code)        (*(volatile uint16 *)0x2000402C = (uint16)(code))   /* COMM12 */
+#define CD_COMM8_32           (*(volatile uint32 *)0x20004028)
+#define CD_COMM12_16          (*(volatile uint16 *)0x2000402C)
+#define CD32X_TEXT            0             /* OL-3: no green/white text - splash screen instead */
+
+/* ---------------------------------------------------------------------------------------
+ * OL-3: loading screen.  SPLASH.BIN (tools/make_ol_splash.py, built into the ROM by asm/data.s):
+ *   256 palette entries (32X BGR555, big-endian), then 320 x 180 pixels, one byte each.
+ *   Indices 0-251 = the picture, 252 black, 253 bar background, 254 bar (red), 255 bar edge.
+ * Both frame buffers get the picture; the red bar along the bottom grows after every chunk.
+ * All frame-buffer writes are 16-bit (KOBO doc, rule 4).
+ * --------------------------------------------------------------------------------------- */
+extern void* SPLASH_BIN;                           /* asm/data.s */
+#define SPL_W       320
+#define SPL_H       180
+#define SPL_TOP     14
+#define BAR_X0      14                             /* outer edge, even */
+#define BAR_X1      306                            /* outer edge, exclusive, even */
+#define BAR_Y0      198
+#define BAR_Y1      214
+#define C_BLACK     252
+#define C_BARBG     253
+#define C_BAR       254
+#define C_EDGE      255
+
+void osSetPalette(const uint16* palette);
+void pageWait();
+void pageFlip();
+void pageClear();
+static const uint16* gGamePalette = 0;             /* OL-3: the game palette, restored after a load */
+
+static uint8 splashBarColor(int32 x, int32 y, int32 fill)
+{
+    if (y < BAR_Y0 + 2 || y >= BAR_Y1 - 2 || x < BAR_X0 + 2 || x >= BAR_X1 - 2)
+        return C_EDGE;
+    return (x - (BAR_X0 + 2) < fill) ? C_BAR : C_BARBG;
+}
+
+static void splashBar(int32 done, int32 total)
+{
+    int32 inner = (BAR_X1 - 2) - (BAR_X0 + 2);
+    int32 fill = (total > 0) ? (inner * done) / total : 0;
+    volatile uint16* fb = (volatile uint16*)&MARS_FRAMEBUFFER + 0x100;
+    for (int32 y = BAR_Y0; y < BAR_Y1; y++)
+    {
+        volatile uint16* row = fb + y * (FRAME_WIDTH / 2);
+        for (int32 x = BAR_X0; x < BAR_X1; x += 2)
+            row[x >> 1] = (uint16)((splashBarColor(x, y, fill) << 8) | splashBarColor(x + 1, y, fill));
+    }
+}
+
+static void splashPage(int32 done, int32 total)
+{
+    volatile uint16* fb = (volatile uint16*)&MARS_FRAMEBUFFER + 0x100;
+    const uint16* pix = (const uint16*)((const uint8*)SPLASH_BIN + 512);
+    const uint16 black = (C_BLACK << 8) | C_BLACK;
+    for (int32 y = 0; y < FRAME_HEIGHT; y++)
+    {
+        volatile uint16* row = fb + y * (FRAME_WIDTH / 2);
+        if (y >= SPL_TOP && y < SPL_TOP + SPL_H)
+        {
+            const uint16* src = pix + (y - SPL_TOP) * (SPL_W / 2);
+            for (int32 x = 0; x < FRAME_WIDTH / 2; x++)
+                row[x] = src[x];
+        }
+        else
+        {
+            for (int32 x = 0; x < FRAME_WIDTH / 2; x++)
+                row[x] = black;
+        }
+    }
+    splashBar(done, total);
+}
+
+static void splashBegin()
+{
+    const uint16* gamePal = gGamePalette;
+    osSetPalette((const uint16*)SPLASH_BIN);       /* the picture's own colours */
+    gGamePalette = gamePal;                        /* ...but remember the game's */
+    for (int32 i = 0; i < 2; i++)                  /* the same picture in both buffers */
+    {
+        pageWait();
+        splashPage(0, 1);
+        pageFlip();
+    }
+    pageWait();
+}
+
+static void splashProgress(int32 done, int32 total)
+{
+    for (int32 i = 0; i < 2; i++)                  /* bar in both buffers, shown at once */
+    {
+        splashBar(done, total);
+        pageFlip();
+        pageWait();
+    }
+}
+
+static void splashEnd()
+{
+    for (int32 i = 0; i < 2; i++)                  /* nothing of the picture left behind */
+    {
+        pageClear();
+        pageFlip();
+        pageWait();
+    }
+    if (gGamePalette)
+        osSetPalette(gGamePalette);
