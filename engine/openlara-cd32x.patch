+struct Mutant : Enemy
+{
+    // ENEMIES-2: winged / shooting / ground mutants (Egypt, Atlantis).  Ported from the full
+    // engine; the projectiles are instant shots here, the winged one flies like the bat.
+    enum {
+        HIT_MASK        = 0x0678,
+        DIST_ATTACK_1   = 600,
+        DIST_ATTACK_2   = 2560,
+        DIST_ATTACK_3   = 300,
+        DIST_SHOT       = 3840,
+        DIST_STALK      = 4608,
+        DAMAGE_SHOT     = 50
+    };
+
+    enum {
+        STATE_NONE,
+        STATE_STOP,
+        STATE_WALK,
+        STATE_RUN,
+        STATE_ATTACK_1,
+        STATE_DEATH,
+        STATE_LOOKING,
+        STATE_ATTACK_2,
+        STATE_ATTACK_3,
+        STATE_AIM_1,
+        STATE_AIM_2,
+        STATE_FIRE,
+        STATE_IDLE,
+        STATE_FLY
+    };
+
+    Mutant(Room* room) : Enemy(room, 50, 341, 150, AGGRESSION_LVL_MAX) {}
+
+    virtual int32 updateState()
+    {
+        if (health <= 0)
+            return (state == STATE_FLY) ? STATE_STOP : STATE_DEATH;
+
+        if (nextState == state)
+            nextState = STATE_NONE;
+
+        bool flyer = false;
+        bool shooter = !(false);
+
+        bool shootFar = shooter && tinfo.front && (abs(tinfo.angle) < ANGLE(45)) &&
+                        (tinfo.dist > DIST_SHOT || !checkZone()) && canSee(8192);
+        bool wantFly = flyer && !shootFar && (mood == MOOD_ESCAPE || !checkZone());
+
+        if (state == STATE_FLY)
+        {
+            extraE->nav.stepHeight = 30 * 1024;
+            extraE->nav.dropHeight = -30 * 1024;
+            extraE->nav.vSpeed = 16;
+            extraE->maxTurn = ANGLE(6);
+            if (!wantFly && pos.y >= roomFloor - 128)
+                return STATE_STOP;
+            return STATE_FLY;
+        }
+
+        extraE->nav.stepHeight = 256;
+        extraE->nav.dropHeight = -256;
+
+        switch (state)
+        {
+            case STATE_STOP:
+            {
+                if (wantFly)
+                    return STATE_FLY;
+                if ((tinfo.canAttack && tinfo.dist < DIST_ATTACK_3) || (hitMask & HIT_MASK))
+                    return STATE_ATTACK_3;
+                if (tinfo.canAttack && tinfo.dist < DIST_ATTACK_1)
+                    return STATE_ATTACK_1;
+                if (shootFar)
+                    return (rand_logic() & 1) ? STATE_AIM_1 : STATE_AIM_2;
+                if (mood == MOOD_SLEEP || (mood == MOOD_STALK && tinfo.dist < DIST_STALK))
+                    return STATE_LOOKING;
+                return STATE_RUN;
+            }
+
+            case STATE_WALK:
+            {
+                extraE->maxTurn = ENEMY_TURN_2;
+                if (shootFar || wantFly || mood == MOOD_ATTACK || mood == MOOD_ESCAPE)
+                    return STATE_STOP;
+                if (mood == MOOD_SLEEP || (mood == MOOD_STALK && !checkZone())) {
+                    if (rand_logic() < 50)
+                        return STATE_LOOKING;
+                } else if (mood == MOOD_STALK && tinfo.dist > DIST_STALK) {
+                    return STATE_STOP;
+                }
+                break;
+            }
+
+            case STATE_RUN:
+            {
+                extraE->maxTurn = ANGLE(6);
+                tinfo.tilt = tinfo.turn;
+                if (wantFly || (hitMask & HIT_MASK))
+                    return STATE_STOP;
+                if (tinfo.canAttack && tinfo.dist < DIST_ATTACK_1)
+                    return STATE_STOP;
+                if (tinfo.front && tinfo.dist < DIST_ATTACK_2)
+                    return STATE_ATTACK_2;
+                if (shootFar)
+                    return STATE_STOP;
+                if (mood == MOOD_SLEEP || (mood == MOOD_STALK && tinfo.dist < DIST_STALK))
+                    return STATE_STOP;
+                break;
+            }
+
+            case STATE_LOOKING:
+            {
+                if (shootFar || wantFly)
+                    return STATE_STOP;
+                if (mood == MOOD_SLEEP) {
+                    if (rand_logic() < 256)
+                        return STATE_WALK;
+                } else if (mood == MOOD_STALK) {
+                    if (tinfo.dist >= DIST_STALK)
+                        return STATE_STOP;
+                    if (checkZone() && rand_logic() < 256)
+                        return STATE_WALK;
+                } else {
+                    return STATE_STOP;
+                }
+                break;
+            }
+
+            case STATE_ATTACK_1:
+            case STATE_ATTACK_2:
+            case STATE_ATTACK_3:
+            {
+                if (!nextState && (hitMask & HIT_MASK)) {
+                    int32 damage = (state == STATE_ATTACK_1) ? 150 : ((state == STATE_ATTACK_2) ? 100 : 200);
+                    bite(damage, _vec3i(-27, 98, 0), 10);
+                    nextState = STATE_STOP;
+                }
+                break;
+            }
+
+            case STATE_AIM_1:
+            case STATE_AIM_2:
+                return shootFar ? STATE_FIRE : STATE_STOP;
+
+            case STATE_FIRE:
+            {
+                if (!nextState) {
+                    shoot(DAMAGE_SHOT, 8192);
+                    nextState = STATE_STOP;
+                }
+                break;
+            }
+
+            case STATE_IDLE:
+                return STATE_STOP;
+        }
+
+        return goalState;
+    }
+};
