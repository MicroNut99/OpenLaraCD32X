+struct Rat : Enemy
+{
+    // ENEMIES-1: rat behaviour (ported from the full engine)
+    enum {
+        HIT_MASK         = 0x0300018F,
+        DIST_BITE        = 341,
+        DIST_ATTACK      = 1536,
+        WAIT_CHANCE      = 0x148,          // 1 % per frame, as RAT_WAIT
+        DAMAGE           = 20,
+        ANIM_DEATH_LAND  = 8,
+        ANIM_DEATH_WATER = 2
+    };
+
+    enum {  // land
+        STATE_NONE,
+        STATE_STOP,
+        STATE_ATTACK,
+        STATE_RUN,
+        STATE_BITE,
+        STATE_DEATH,
+        STATE_WAIT
+    };
+
+    enum {  // water
+        STATE_WATER_SWIM = 1,
+        STATE_WATER_BITE,
+        STATE_WATER_DEATH
+    };
+
+    Rat(Room* room) : Enemy(room, 5, 204, 200, AGGRESSION_LVL_2) {}
+
+    virtual void hit(int32 damage, const vec3i &point, int32 soundId)
+    {
+        Enemy::hit(damage, point, SND_HIT_RAT);
+
+        if (health <= 0) {
+            int32 anim = (type == ITEM_RAT_WATER) ? ANIM_DEATH_WATER : ANIM_DEATH_LAND;
+            animSet(level.models[type].animIndex + anim, true);
+        }
+    }
+
+    virtual int32 updateState()
+    {
+        if (health <= 0)
+            return goalState;
+
+        if (nextState == state)
+            nextState = STATE_NONE;
+
+        if (type == ITEM_RAT_WATER)
+        {
+            switch (state)
+            {
+                case STATE_WATER_SWIM:
+                {
+                    extraE->maxTurn = ANGLE(6);
+                    if (tinfo.front && (hitMask & HIT_MASK))
+                        return STATE_WATER_BITE;
+                    break;
+                }
+                case STATE_WATER_BITE:
+                {
+                    if (!nextState && tinfo.front && (hitMask & HIT_MASK)) {
+                        bite(DAMAGE, _vec3i(0, -11, 108), 3);
+                        nextState = STATE_WATER_SWIM;
+                    }
+                    return STATE_WATER_SWIM;
+                }
+            }
+            return goalState;
+        }
+
+        switch (state)
+        {
+            case STATE_STOP:
+            {
+                if (nextState)
+                    return nextState;
+                if (tinfo.canAttack && tinfo.dist < DIST_BITE)
+                    return STATE_BITE;
+                return STATE_RUN;
+            }
+
+            case STATE_RUN:
+            {
+                extraE->maxTurn = ANGLE(6);
+                tinfo.tilt = tinfo.turn;
+                if (tinfo.front && (hitMask & HIT_MASK))
+                    return STATE_STOP;
+                if (tinfo.canAttack && tinfo.dist < DIST_ATTACK)
+                    return STATE_ATTACK;
+                if (tinfo.front && rand_logic() < WAIT_CHANCE) {
+                    nextState = STATE_WAIT;
+                    return STATE_STOP;
+                }
+                break;
+            }
+
+            case STATE_ATTACK:
+            case STATE_BITE:
+            {
+                if (!nextState && tinfo.front && (hitMask & HIT_MASK)) {
+                    bite(DAMAGE, _vec3i(0, -11, 108), 3);
+                    nextState = (state == STATE_ATTACK) ? STATE_RUN : STATE_STOP;
+                }
+                break;
+            }
+
+            case STATE_WAIT:
+            {
+                if (mood == MOOD_SLEEP || rand_logic() < WAIT_CHANCE)
+                    return STATE_STOP;
+                break;
+            }
+        }
+
+        return goalState;
+    }
+};
+
